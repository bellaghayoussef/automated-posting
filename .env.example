# ==============================================================================
# Automated Multi-Platform Posting System - Environment Variables
# ==============================================================================

# Application Configuration
APP_NAME="Automated Multi-Platform Posting System"
APP_HOST="0.0.0.0"
APP_PORT=4000
DEBUG=false
REQUEST_TIMEOUT=15.0

# Demo / Simulation Mode:
# Set to 'true' to simulate successful responses for platforms without credentials.
# Set to 'false' (default) to make live HTTP calls to real APIs.
MOCK_MODE=false

# ------------------------------------------------------------------------------
# 1. Telegram Platform Integration
# Documentation: https://core.telegram.org/bots/api#sendmessage
# Setup: Create a bot with @BotFather to get the token.
#        Add the bot as an administrator to your channel.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# 2. Discord Platform Integration
# Documentation: https://discord.com/developers/docs/resources/webhook#execute-webhook
# Setup: In your Discord server, go to Channel Settings -> Integrations -> Webhooks -> New Webhook.
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 3. Slack Platform Integration
# Documentation: https://api.slack.com/messaging/webhooks
# Setup: Create an Incoming Webhook in Slack API app settings OR provide bot token.
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=""
# Alternative Bot Token method:
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""

# ------------------------------------------------------------------------------
# 4. Mastodon Platform Integration
# Documentation: https://docs.joinmastodon.org/methods/statuses/#create
# Setup: Go to your Mastodon instance (e.g., https://mastodon.social) -> Preferences
#        -> Development -> New Application -> select 'write:statuses' scope.
# ------------------------------------------------------------------------------
MASTODON_INSTANCE_URL="https://mastodon.social"
MASTODON_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# 5. Bluesky Platform Integration (AT Protocol)
# Documentation: https://docs.bsky.app/docs/api/com-atproto-repo-create-record
# Setup: Go to bsky.app -> Settings -> Privacy and Security -> App Passwords -> Add App Password.
# ------------------------------------------------------------------------------
BLUESKY_IDENTIFIER=""
BLUESKY_APP_PASSWORD=""
BLUESKY_PDS_URL="https://bsky.social"
